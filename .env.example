# ==============================================================================
# MNV Server Scripts - Environment Variables Template
# Copy this file or export these variables before running bootstrap-server.sh
# ==============================================================================

# [BẮT BUỘC] Cloudflare R2 / S3-compatible Object Storage Credentials
# Tạo API Token trên Cloudflare Dashboard với quyền Read/Write trên R2 Bucket
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here

# [TÙY CHỌN] Cấu hình Domain & Port cho MNV Panel
# Nếu để trống PANEL_DOMAIN, panel sẽ chạy mặc định qua http://<SERVER_IP>:4000
PANEL_DOMAIN=panel.example.com
PANEL_PORT=4000

# [TÙY CHỌN] Phiên bản & Snapshot khôi phục
# PANEL_SHA=abc1234               # Cài commit panel cụ thể thay vì bản mới nhất
# STATE_KEY=backups/panel/...     # Snapshot SQLite cụ thể trên R2
# FRESH=1                         # Cài panel trắng hoàn toàn (không restore dữ liệu cũ)
# R2_ENDPOINT=https://...         # S3 Endpoint tùy chỉnh nếu dùng MinIO hoặc AWS S3

